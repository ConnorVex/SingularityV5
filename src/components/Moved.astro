---
// A page that moved to the Divine Database site. Sends the visitor there, keeping any ?query and
// #hash (family links and edit links carry them), so old links and bookmarks keep working.
// Usage: <Moved to="families/view/" />
interface Props {
	/** Path on the Divine Database site, without a leading slash. */
	to: string;
}

const target = `https://connorvex.github.io/DivineDatabase/${Astro.props.to}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Moved to the Divine Database</title>
		<link rel="canonical" href={target} />
		<script is:inline define:vars={{ target }}>
			location.replace(target + location.search + location.hash);
		</script>
		<meta http-equiv="refresh" content={`0; url=${target}`} />
	</head>
	<body>
		<p>This page moved to the <a href={target}>Divine Database</a>.</p>
	</body>
</html>
