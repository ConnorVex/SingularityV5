---
// Interactive skill tree. Nodes are laid out in rows by how many requirements deep they are,
// connected with lines, and can be clicked to plan a build (saved in the visitor's browser).
// Nodes with no cost unlock by themselves as soon as their requirements are met.
// Usage: <SkillTree id="infamous-psychic" nodes={tree.nodes} />, with data from src/data/skill-trees/.
// The markup and behaviour live in src/lib/skill-tree.ts, shared with locked systems.
import { skillTreeHtml, type SkillNode } from '../lib/skill-tree';
import '../styles/skill-tree.css';

interface Props {
	/** Unique per tree; used as the key for the saved build. */
	id: string;
	nodes: SkillNode[];
	/** Give each branch that begins at a starting point its own color. */
	colorBranches?: boolean;
}

const { id, nodes, colorBranches = false } = Astro.props;
---

<Fragment set:html={skillTreeHtml(id, nodes, colorBranches)} />

<script>
	import { initSkillTree } from '../lib/skill-tree';

	for (const tree of document.querySelectorAll<HTMLElement>('.skill-tree')) initSkillTree(tree);
</script>
